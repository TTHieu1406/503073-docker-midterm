# Rendered at start-up by the Nginx entrypoint (envsubst), so that the same image
# works under Docker Compose and Kubernetes:
#   ${NGINX_LOCAL_RESOLVERS}  the DNS server from /etc/resolv.conf
#   ${API_UPSTREAM}           api:4000, or the full service name on Kubernetes
#   ${WEB_UPSTREAM}           web:8080 in production, web:5173 in development

resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

upstream api_backend {
    zone api_backend 128k;
    # `resolve` makes Nginx re-read DNS while running: replicas added with
    # `--scale` receive traffic within seconds, without a reload.
    server ${API_UPSTREAM} resolve max_fails=2 fail_timeout=5s;
}

upstream web_frontend {
    zone web_frontend 64k;
    server ${WEB_UPSTREAM} resolve;
}

# WebSocket upgrades pass through (hot reload in development). Everything else asks
# for the connection to close: since Nginx 1.29.7, upstream connections are kept open
# by default, and a Kubernetes Service balances per connection, so a kept connection
# would pin each Nginx worker to a single Pod.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Brute-force protection for the login form, keyed by client address.
limit_req_zone $binary_remote_addr zone=login:10m rate=20r/m;
limit_req_status 429;

server {
    listen 8080;
    client_max_body_size 1m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws:; frame-ancestors 'none'" always;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 2s;

    location = /gateway/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://api_backend;
    }

    # Server-Sent Events: a long-lived response that must not be buffered.
    location = /api/events {
        proxy_pass http://api_backend;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://api_backend;
        # If a replica has just died, retry on another one so the visitor never
        # notices. Only safe methods are retried, so an order is never placed twice.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 5s;
    }

    location / {
        proxy_pass http://web_frontend;
    }
}
