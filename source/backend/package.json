{
  "name": "dockmart-backend",
  "version": "1.0.0",
  "description": "DockMart API, background worker and database migrator (one image, three commands).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "lint": "eslint src test",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0"
  }
}
